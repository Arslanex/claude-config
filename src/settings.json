{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "tui": "fullscreen",
  "model": "claude-opus-5-5",
  "env": {
    "ARCHIFY_UPDATE_CHECK_DISABLED": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(gh auth status)",
      "Bash(gh repo view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "mcp__playwright",
      "mcp__cloudflare-api__docs",
      "mcp__cloudflare-api__search",
      "mcp__cloudflare-api__whoami",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(gh api --method DELETE *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh auth logout *)",
      "Bash(gh auth token *)",
      "Bash(gh repo delete *)",
      "Bash(gh secret *)",
      "Edit(~/.claude.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/settings.json)",
      "Read(**/*.env)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials*.json)",
      "Read(**/secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.pypirc)",
      "Read(~/.ssh/**)",
      "mcp__playwright__browser_run_code_unsafe"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh repo create *)",
      "mcp__cloudflare-api__execute"
    ]
  },
  "autoCompactWindow": 400000,
  "disableClaudeAiConnectors": true,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.pypirc",
        "~/.netrc"
      ],
      "allowRead": [
        "~/.cache/uv/**/certifi/cacert.pem"
      ],
      "allowWrite": [
        "~/.cache",
        "~/.local/share/uv",
        "~/.npm",
        "~/.semgrep"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "proxy.golang.org",
        "rubygems.org",
        "*.githubusercontent.com",
        "semgrep.dev"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "dockerw *"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/guard.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/dep-guard.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/edit-guard.py\""
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/notify.py\""
          }
        ]
      },
      {
        "matcher": "mcp__context7__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/context7-guard.py\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/notify.py\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/notify.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/notify.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/stop-gate.py\"",
            "timeout": 330
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/detect-profile.py\""
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/compact-context.py\""
          }
        ]
      }
    ]
  }
}
