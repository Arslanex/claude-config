[importlinter]
root_package = PKG_NAME
include_external_packages = True

[importlinter:contract:layers]
name = Katman yonu (ARCH-0005)
type = layers
layers =
    PKG_NAME.interface | PKG_NAME.worker
    PKG_NAME.features
    PKG_NAME.lib
    PKG_NAME.infra
    PKG_NAME.core | PKG_NAME.config

[importlinter:contract:interface-no-models]
name = interface dogrudan ORM modelini import etmez (ARCH-0005)
type = forbidden
source_modules =
    PKG_NAME.interface
forbidden_modules =
    PKG_NAME.infra.database.models
allow_indirect_imports = True
