{
  "servers": [
    {
      "name": "playwright",
      "scope": "user",
      "transport": "stdio",
      "command": ["npx", "-y", "@playwright/mcp@0.0.84", "--browser", "chromium"]
    },
    {
      "name": "cloudflare-api",
      "scope": "user",
      "transport": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "post_install": "Open Claude Code, run /mcp and authenticate with Cloudflare (OAuth)"
    }
  ]
}
